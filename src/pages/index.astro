---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import heroImage from '../assets/nuestra-historia.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../utils/slug';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 3);

const countryCounts = new Map<string, { country: string; count: number }>();
for (const post of posts) {
	if (!post.data.country) continue;
	const slug = slugify(post.data.country);
	const existing = countryCounts.get(slug);
	if (existing) {
		existing.count += 1;
	} else {
		countryCounts.set(slug, { country: post.data.country, count: 1 });
	}
}
const topCountries = [...countryCounts.entries()]
	.sort((a, b) => b[1].count - a[1].count || a[1].country.localeCompare(b[1].country))
	.slice(0, 6);

const highlights = [
	{
		icon: 'route',
		title: 'Rutas detalladas',
		description: 'Itinerarios paso a paso con mapas, distancias y paradas imprescindibles.',
	},
	{
		icon: 'mountain',
		title: 'Destinos reales',
		description: 'Lugares que hemos recorrido y comprobado en persona, sin filtros.',
	},
	{
		icon: 'book',
		title: 'Guías prácticas',
		description: 'Consejos de presupuesto, transporte y alojamiento para viajar mejor.',
	},
] as const;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="relative w-full h-[60vh] overflow-hidden">
		<Image
			src={heroImage}
			width={1600}
			height={900}
			alt=""
			aria-hidden="true"
			loading="eager"
			class="absolute inset-0 w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />
		<div class="relative z-10 flex h-full items-center justify-center">
			<div class="max-w-2xl px-4 sm:px-6 text-center bg-white/70 dark:bg-black/50 backdrop-blur-md rounded-2xl p-6 flex flex-col">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-accent-alpha-medium bg-accent-alpha-weak px-3 py-1 text-label-s text-accent-on-background-weak"
			>
				<Icon name="compass" size={14} />
				Blog de viajes y rutas
			</span>
			<h1 class="mt-6 font-heading text-display-l font-light text-neutral-on-background-strong">
				Conectamos rutas,
				<span class="text-accent-on-background-weak">contamos historias</span>
			</h1>
			<p class="mt-6 text-body-m text-neutral-on-background-medium max-w-lg">
				{SITE_DESCRIPTION} Itinerarios probados, destinos reales y guías prácticas para que
				cada viaje valga la pena desde el primer kilómetro.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="blog"
					class="inline-flex items-center gap-2 rounded-full bg-accent-solid-strong px-5 py-2.5 text-label-m font-medium text-accent-on-solid-strong transition-colors duration-100 hover:bg-accent-solid-medium"
				>
					Explorar el blog
					<Icon name="arrow-right" size={16} />
				</a>
				<a
					href="about"
					class="inline-flex items-center gap-2 rounded-full border border-neutral-alpha-strong px-5 py-2.5 text-label-m font-medium text-neutral-on-background-strong transition-colors duration-100 hover:bg-neutral-alpha-weak"
				>
					Sobre nosotros
					<Icon name="arrow-right" size={16} />
				</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-4 pb-32 sm:px-8 mt-12" aria-label="Por qué seguirnos">
		<div class="grid gap-4 sm:grid-cols-3">
			{
				highlights.map((item) => (
					<div class="rounded-l border border-neutral-alpha-weak bg-neutral-background-weak p-6 transition-colors duration-100 hover:border-neutral-border-medium">
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-alpha-weak text-accent-on-background-weak">
							<Icon name={item.icon} size={20} strokeWidth={1.75} />
						</div>
						<h3 class="mt-4 font-heading text-heading-s text-neutral-on-background-strong">
							{item.title}
						</h3>
						<p class="mt-2 text-body-s text-neutral-on-background-medium">{item.description}</p>
					</div>
				))
			}
		</div>
	</section>

	{
		topCountries.length > 0 && (
			<section class="mx-auto max-w-7xl px-4 pb-24 sm:px-8 mt-12" aria-label="Explora por destino">
				<div class="flex items-end justify-between">
					<div>
						<p class="text-label-s text-accent-on-background-weak">Destinos</p>
						<h2 class="mt-1 font-heading text-heading-xl text-neutral-on-background-strong">
							Explora por destino
						</h2>
					</div>
					<a
						href="/destinos"
						class="hidden items-center gap-1 text-label-m text-neutral-on-background-medium transition-colors duration-100 hover:text-accent-on-background-weak sm:inline-flex"
					>
						Ver todos
						<Icon name="arrow-up-right" size={14} />
					</a>
				</div>
				<div class="mt-6 flex flex-wrap gap-3">
					{topCountries.map(([slug, { country, count }]) => (
						<a
							href={`destinos/${slug}/`}
							class="inline-flex items-center gap-2 rounded-full border border-neutral-alpha-weak bg-neutral-background-weak px-4 py-2 text-label-m text-neutral-on-background-strong transition-colors duration-100 hover:border-accent-border-medium hover:text-accent-on-background-weak"
						>
							<Icon name="map-pin" size={14} strokeWidth={1.75} />
							{country}
							<span class="text-label-s text-neutral-on-background-weak">{count}</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	<section class="mx-auto max-w-7xl px-4 pb-28 sm:px-8 mt-16" aria-label="Últimas publicaciones">
		<div class="flex items-end justify-between">
			<div>
				<p class="text-label-s text-accent-on-background-weak">Últimas rutas</p>
				<h2 class="mt-1 font-heading text-heading-xl text-neutral-on-background-strong">
					Publicaciones recientes
				</h2>
			</div>
			<a
				href="/blog"
				class="hidden items-center gap-1 text-label-m text-neutral-on-background-medium transition-colors duration-100 hover:text-accent-on-background-weak sm:inline-flex"
			>
				Ver todas
				<Icon name="arrow-up-right" size={14} />
			</a>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-3">
			{recentPosts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<section
		class="border-y border-neutral-alpha-weak bg-neutral-background-weak"
		aria-label="Nuestro recorrido"
	>
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 mt-16">
			<p class="text-label-s text-accent-on-background-weak">El recorrido</p>
			<h2 class="mt-1 max-w-xl font-heading text-heading-xl text-neutral-on-background-strong">
				El mapa de nuestro viaje
			</h2>
			<p class="mt-4 max-w-2xl text-body-m text-neutral-on-background-medium">
				Seguí nuestro recorrido en el mapa: cada punto lleva a una historia.
			</p>
			<a
				href="rutas"
				class="mt-6 inline-flex items-center gap-2 rounded-full border border-neutral-alpha-strong px-5 py-2.5 text-label-m font-medium text-neutral-on-background-strong transition-colors duration-100 hover:bg-neutral-alpha-weak"
			>
				<Icon name="route" size={16} strokeWidth={1.75} />
				Ver el mapa
			</a>
		</div>
	</section>

	<section class="border-y border-neutral-alpha-weak bg-neutral-background-weak" aria-label="Sobre nosotros">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-8 mt-20">
			<p class="text-label-s text-accent-on-background-weak">Nosotros</p>
			<h2 class="mt-1 max-w-xl font-heading text-heading-xl text-neutral-on-background-strong">
				Una familia, una mochila y muchas rutas por delante
			</h2>
			<p class="mt-4 max-w-2xl text-body-m text-neutral-on-background-medium">
				Recién empezamos este proyecto: documentamos cada viaje con distancias reales, gastos
				honestos y aprendizajes sobre la marcha, para que planificar tu próxima ruta te cueste
				menos que a nosotros.
			</p>
			<a
				href="/about"
				class="mt-6 inline-flex items-center gap-2 rounded-full border border-neutral-alpha-strong px-5 py-2.5 text-label-m font-medium text-neutral-on-background-strong transition-colors duration-100 hover:bg-neutral-alpha-weak"
			>
				<Icon name="users" size={16} strokeWidth={1.75} />
				Conócenos
			</a>
		</div>
	</section>
</BaseLayout>
