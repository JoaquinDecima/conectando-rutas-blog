---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const highlights = [
	{
		icon: 'route',
		title: 'Rutas detalladas',
		description: 'Itinerarios paso a paso con mapas, distancias y paradas imprescindibles.',
	},
	{
		icon: 'mountain',
		title: 'Destinos reales',
		description: 'Lugares que hemos recorrido y comprobado en persona, sin filtros.',
	},
	{
		icon: 'book',
		title: 'Guías prácticas',
		description: 'Consejos de presupuesto, transporte y alojamiento para viajar mejor.',
	},
] as const;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="mx-auto max-w-6xl px-4 pt-20 pb-16 sm:px-6">
		<div class="max-w-2xl">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-accent-alpha-medium bg-accent-alpha-weak px-3 py-1 text-label-s text-accent-on-background-weak"
			>
				<Icon name="compass" size={14} />
				Blog de viajes y rutas
			</span>
			<h1
				class="mt-6 font-heading text-display-l font-light text-neutral-on-background-strong"
			>
				Conectamos rutas,
				<span class="text-accent-on-background-weak">contamos historias</span>
			</h1>
			<p class="mt-6 text-body-l text-neutral-on-background-medium">
				{SITE_DESCRIPTION} Itinerarios probados, destinos reales y guías prácticas para que
				cada viaje valga la pena desde el primer kilómetro.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="/blog"
					class="inline-flex items-center gap-2 rounded-full bg-accent-solid-strong px-5 py-2.5 text-label-m font-medium text-accent-on-solid-strong transition-colors duration-100 hover:bg-accent-solid-medium"
				>
					Explorar el blog
					<Icon name="arrow-right" size={16} />
				</a>
				<a
					href="/about"
					class="inline-flex items-center gap-2 rounded-full border border-neutral-alpha-strong px-5 py-2.5 text-label-m font-medium text-neutral-on-background-strong transition-colors duration-100 hover:bg-neutral-alpha-weak"
				>
					Sobre nosotros
				</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6" aria-label="Por qué seguirnos">
		<div class="grid gap-4 sm:grid-cols-3">
			{
				highlights.map((item) => (
					<div class="rounded-l border border-neutral-alpha-weak bg-neutral-background-weak p-6 transition-colors duration-100 hover:border-neutral-border-medium">
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-alpha-weak text-accent-on-background-weak">
							<Icon name={item.icon} size={20} strokeWidth={1.75} />
						</div>
						<h3 class="mt-4 font-heading text-heading-s text-neutral-on-background-strong">
							{item.title}
						</h3>
						<p class="mt-2 text-body-s text-neutral-on-background-medium">{item.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6" aria-label="Últimas publicaciones">
		<div class="flex items-end justify-between">
			<div>
				<p class="text-label-s text-accent-on-background-weak">Últimas rutas</p>
				<h2 class="mt-1 font-heading text-heading-xl text-neutral-on-background-strong">
					Publicaciones recientes
				</h2>
			</div>
			<a
				href="/blog"
				class="hidden items-center gap-1 text-label-m text-neutral-on-background-medium transition-colors duration-100 hover:text-accent-on-background-weak sm:inline-flex"
			>
				Ver todas
				<Icon name="arrow-up-right" size={14} />
			</a>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-3">
			{
				posts.map((post) => (
					<article class="group overflow-hidden rounded-l border border-neutral-alpha-weak bg-neutral-background-weak transition-colors duration-100 hover:border-neutral-border-medium">
						<a href={`/blog/${post.id}/`} class="block">
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									class="aspect-2/1 w-full object-cover"
									loading="lazy"
								/>
							)}
							<div class="p-5">
								<p class="text-label-s text-neutral-on-background-weak">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h3 class="mt-2 font-heading text-heading-s text-neutral-on-background-strong transition-colors duration-100 group-hover:text-accent-on-background-weak">
									{post.data.title}
								</h3>
								<p class="mt-2 line-clamp-2 text-body-s text-neutral-on-background-medium">
									{post.data.description}
								</p>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
