---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// Agrupar por país, luego por región
const countries = new Map<string, Map<string, (typeof posts)[number][]>>();
for (const post of posts) {
	const { country, region } = post.data;
	if (!country) continue;
	if (!countries.has(country)) countries.set(country, new Map());
	const regions = countries.get(country)!;
	const key = region ?? '(sin región)';
	if (!regions.has(key)) regions.set(key, []);
	regions.get(key)!.push(post);
}

const sortedCountries = [...countries.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout
	title={`Destinos - ${SITE_TITLE}`}
	description="Explora todos los destinos del blog: países y regiones con itinerarios, presupuestos y consejos de viaje documentados por Conectando Rutas."
>
	<section class="mx-auto max-w-7xl px-4 py-16 sm:px-8">
		<div>
			<p class="text-label-s text-accent-on-background-weak">Destinos</p>
			<h1
				class="mt-1 font-heading text-display-s font-light text-neutral-on-background-strong"
			>
				Todos los destinos recorridos
			</h1>
			<p class="mt-4 max-w-xl text-body-m text-neutral-on-background-medium">
				Cada país que hemos cruzado, con sus rutas, presupuestos y consejos reunidos en un
				solo lugar.
			</p>
		</div>

		{sortedCountries.map(([country, regions]) => (
			<section class="mt-12">
				<div class="border-b border-neutral-alpha-weak pb-3">
					<h2 class="font-heading text-heading-m text-neutral-on-background-strong">
						{country}
					</h2>
				</div>
				{regions.size === 1 && (
					<div class="mt-6 grid gap-6 sm:grid-cols-2">
						{[...regions.values()]
							.flat()
							.map((post) => (
								<PostCard post={post} headingLevel="h3" />
							))}
					</div>
				)}
				{regions.size > 1 && (
					<>
						{[...regions.entries()]
							.sort((a, b) => a[0].localeCompare(b[0]))
							.map(([region, regionPosts]) => (
								<section class="mt-8">
									<h3
										class="font-heading text-heading-s text-neutral-on-background-medium mb-4"
									>
										{region}
									</h3>
									<div class="grid gap-6 sm:grid-cols-2">
										{regionPosts.map((post) => (
											<PostCard post={post} headingLevel="h3" />
										))}
									</div>
								</section>
							))}
					</>
				)}
			</section>
		))}
	</section>
</BaseLayout>
