---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category } = Astro.props;
const posts = (
	await getCollection('blog', (post) => post.data.category === category.slug)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title={`${category.label} - ${SITE_TITLE}`}
	description={`${category.description} Artículos seleccionados de Conectando Rutas para planificar tu próximo viaje con información real.`}
>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div>
			<p class="text-label-s text-accent-on-background-weak">Temas</p>
			<h1
				class="mt-1 font-heading text-display-s font-light text-neutral-on-background-strong"
			>
				{category.label}
			</h1>
			<p class="mt-4 max-w-xl text-body-m text-neutral-on-background-medium">
				{category.description}
			</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{
				posts.length > 0 ? (
					posts.map((post) => <PostCard post={post} headingLevel="h2" />)
				) : (
					<p class="text-body-m text-neutral-on-background-weak">
						Aún no hay artículos en esta categoría. Vuelve pronto: estamos escribiendo las
						primeras rutas.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>
