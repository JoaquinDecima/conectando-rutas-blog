---
import mapData from '../data/map-data.json';

interface MapPoint {
	id: string;
	name: string;
	description: string;
	country: string;
	href: string;
	trip: string;
	x: number;
	y: number;
}

interface MapTrip {
	id: string;
	name: string;
	colorToken: string;
	d: string;
	points: MapPoint[];
}

interface MapData {
	viewBox: [number, number];
	countries: Array<{ name: string; d: string }>;
	trips: MapTrip[];
	points: MapPoint[];
}

const map = mapData as unknown as MapData;
const [width, height] = map.viewBox;
const countryNames = map.countries.map((c) => c.name).join(' y ');

function esc(s: string): string {
	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

const countryPathsHtml = map.countries
	.map(
		(c) =>
			`<path d="${esc(c.d)}" fill="var(--neutral-background-medium)" stroke="var(--neutral-alpha-strong)" stroke-width="1" vector-effect="non-scaling-stroke" />`
	)
	.join('');

const routesHtml = map.trips
	.map(
		(trip) =>
			`<g class="map-route"><path d="${esc(trip.d)}" fill="none" stroke-linejoin="round" stroke-linecap="round" stroke="var(--neutral-background-weak)" stroke-width="6" opacity="0.9" /><path d="${esc(trip.d)}" fill="none" stroke-linejoin="round" stroke-linecap="round" stroke="var(--${trip.colorToken})" stroke-width="3" /></g>`
	)
	.join('');

const pinsHtml = map.points
	.map(
		(p) =>
			`<a href="${esc(p.href)}" class="map-pin" aria-label="${esc(p.name + ' — leer artículo')}"><title>${esc(p.name + ' — ' + p.description)}</title><circle class="map-pin-base" cx="${p.x}" cy="${p.y}" r="10" fill="var(--accent-solid-strong)" stroke="var(--page-background)" stroke-width="2" vector-effect="non-scaling-stroke" /><circle class="map-pin-dot" cx="${p.x}" cy="${p.y}" r="3.5" fill="var(--page-background)" /></a>`
	)
	.join('');

const svgHtml = `
<svg viewBox="0 0 ${width} ${height}" class="mx-auto h-auto w-auto max-h-[70vh] max-w-full" role="img" aria-label="Mapa de nuestro recorrido por ${esc(countryNames)}: líneas de ruta y puntos que enlazan a las historias del blog">
	<g class="map-land" aria-hidden="true">${countryPathsHtml}</g>
	<g class="map-routes" aria-hidden="true">${routesHtml}</g>
	<g id="map-pins">${pinsHtml}</g>
</svg>
`;

---
<div class="relative rounded-l border border-neutral-alpha-weak bg-neutral-background-weak p-4 sm:p-6" set:html={svgHtml} />