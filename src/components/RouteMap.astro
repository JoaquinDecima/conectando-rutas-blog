---
import mapData from '../data/map-data.json';

interface MapPoint {
	id: string;
	name: string;
	description: string;
	country: string;
	href: string;
	trip: string;
	x: number;
	y: number;
}

interface MapTrip {
	id: string;
	name: string;
	colorToken: string;
	d: string;
	points: MapPoint[];
}

interface MapData {
	viewBox: [number, number];
	countries: Array<{ name: string; d: string }>;
	trips: MapTrip[];
	points: MapPoint[];
}

const map = mapData as unknown as MapData;
const [width, height] = map.viewBox;
const countryNames = map.countries.map((c) => c.name).join(' y ');

function esc(s: string): string {
	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-20">
	<div class="text-center mb-8">
		<h2 class="font-heading text-display-m font-light text-neutral-on-background-strong mb-2">El mapa de mis rutas</h2>
		<p class="text-body-m text-neutral-on-background-medium max-w-2xl mx-auto">
			Lugares que he visitado y rutas recorridas. Haz clic en cada pin para leer la historia completa.
		</p>
	</div>

	<div class="relative aspect-[4/3] w-full overflow-hidden">
		<!-- Canvas de agua (efecto ripple, debajo del mapa) -->
		<canvas id="water-canvas" class="absolute inset-0 w-full h-full block z-0" aria-hidden="true"></canvas>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox={`0 0 ${width} ${height}`}
			preserveAspectRatio="xMidYMid meet"
			class="w-full h-full block route-map z-10"
			aria-label="Mapa de rutas y destinos visitados"
		>
			<defs>
				<style>
					{`
						.route-map .map-country {
							fill: #ffffffaa;
							transition: fill var(--transition-micro-medium);
						}
						.route-map .map-country:hover {
							fill: var(--accent-background-medium);
						}
					`}
				</style>
			</defs>

			<!-- Países de fondo (semi-transparentes para ver el agua y las ondas) -->
			{map.countries.map((c) => (
				<path
					class="map-country"
					d={c.d}
					fill="#ffffffaa"
					stroke="var(--neutral-alpha-strong)"
					stroke-width="1"
					vector-effect="non-scaling-stroke"
				/>
			))}

			<!-- Rutas -->
			{map.trips.map((trip) => (
				<g class="map-route">
					<path
						d={trip.d}
						fill="none"
						stroke-linejoin="round"
						stroke-linecap="round"
						stroke="var(--neutral-background-medium)"
						stroke-width="6"
						opacity="0.9"
					/>
					<path
						d={trip.d}
						fill="none"
						stroke-linejoin="round"
						stroke-linecap="round"
						stroke={`var(--${trip.colorToken})`}
						stroke-width="3"
					/>
				</g>
			))}

			<!-- Pins -->
			{map.points.map((p) => (
				<a
					href={p.href}
					class="map-pin"
					aria-label={esc(p.name + ' — leer artículo')}
				>
					<title>{esc(p.name + ' — ' + p.description)}</title>
					<circle
						class="map-pin-base"
						cx={p.x}
						cy={p.y}
						r="10"
						fill="var(--accent-solid-strong)"
						stroke="var(--page-background)"
						stroke-width="2"
						vector-effect="non-scaling-stroke"
					/>
					<circle
						class="map-pin-dot"
						cx={p.x}
						cy={p.y}
						r="3.5"
						fill="var(--page-background)"
					/>
				</a>
			))}
		</svg>
	</div>

	<div class="mt-6 text-body-s text-neutral-on-background-weak">
		Países mostrados: {countryNames}. Atribución: datos de límites de OpenStreetMap contributors.
	</div>
</section>

<script>
	(function () {
		var canvas = document.getElementById('water-canvas');
		var svg = document.querySelector('.route-map');
		if (!canvas || !svg) return;

		var ctx = canvas.getContext('2d');
		var dpr = window.devicePixelRatio || 1;
		var width = 0;
		var height = 0;
		var drops = [];

		function resize() {
			var rect = svg.getBoundingClientRect();
			canvas.width = rect.width * dpr;
			canvas.height = rect.height * dpr;
			canvas.style.width = rect.width + 'px';
			canvas.style.height = rect.height + 'px';
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			width = rect.width;
			height = rect.height;
		}

		window.addEventListener('resize', resize);
		resize();

		function drawBackground() {
			ctx.fillStyle = '#f1f5f9';
			ctx.fillRect(0, 0, width, height);

			ctx.strokeStyle = '#cbd5e1';
			ctx.lineWidth = 1;
			ctx.beginPath();
			for (var i = 0; i <= height; i += 30) {
				ctx.moveTo(0, i);
				for (var x = 0; x <= width; x += 60) {
					var y = i + Math.sin(x * 0.05 + Date.now() * 0.002) * 4;
					ctx.lineTo(x, y);
				}
			}
			ctx.stroke();
		}

		function addDrop(x, y) {
			drops.push({
				x: x,
				y: y,
				r: 0,
				maxR: Math.max(width, height) * 0.8,
				start: Date.now(),
				life: 700
			});
			if (drops.length > 3) drops.shift();
		}

		function draw() {
			drawBackground();

			var now = Date.now();
			var hasActive = false;

			for (var i = drops.length - 1; i >= 0; i--) {
				var d = drops[i];
				var elapsed = now - d.start;
				var p = Math.min(elapsed / d.life, 1);

				if (p >= 1) {
					drops.splice(i, 1);
					continue;
				}

				hasActive = true;
				var ease = 1 - Math.pow(1 - p, 3);
				var r = ease * d.maxR;
				var opacity = 0.35 * (1 - p);

				ctx.beginPath();
				ctx.arc(d.x, d.y, r, 0, Math.PI * 2);
				ctx.fillStyle = 'rgba(94, 114, 128, ' + opacity + ')';
				ctx.fill();

				ctx.beginPath();
				ctx.arc(d.x, d.y, r, 0, Math.PI * 2);
				ctx.strokeStyle = 'rgba(94, 114, 128, ' + (opacity * 0.6) + ')';
				ctx.lineWidth = 2;
				ctx.stroke();
			}

			if (hasActive) {
				requestAnimationFrame(draw);
			}
		}

		svg.addEventListener('mousemove', function (evt) {
			var rect = svg.getBoundingClientRect();
			var x = evt.clientX - rect.left;
			var y = evt.clientY - rect.top;
			addDrop(x, y);
			if (drops.length === 1) requestAnimationFrame(draw);
		});
	})();
</script>
