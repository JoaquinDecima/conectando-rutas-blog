---
import mapData from '../data/map-data.json';

interface MapPoint {
	id: string;
	name: string;
	description: string;
	country: string;
	href: string;
	trip: string;
	x: number;
	y: number;
}

interface MapTrip {
	id: string;
	name: string;
	colorToken: string;
	d: string;
	points: MapPoint[];
}

interface MapData {
	viewBox: [number, number];
	countries: Array<{ name: string; d: string }>;
	trips: MapTrip[];
	points: MapPoint[];
}

const map = mapData as unknown as MapData;
const [width, height] = map.viewBox;
const countryNames = map.countries.map((c) => c.name).join(' y ');

function esc(s: string): string {
	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-20">
	<div class="text-center mb-8">
		<h2 class="font-heading text-display-m font-light text-neutral-on-background-strong mb-2">El mapa de mis rutas</h2>
		<p class="text-body-m text-neutral-on-background-medium max-w-2xl mx-auto">
			Lugares que he visitado y rutas recorridas. Haz clic en cada pin para leer la historia completa.
		</p>
	</div>

	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox={`0 0 ${width} ${height}`}
		preserveAspectRatio="xMidYMid meet"
		class="w-full h-full block route-map"
		aria-label="Mapa de rutas y destinos visitados"
		role="img"
	>
		<style>
			{`
				.map-route path { vector-effect: non-scaling-stroke; }
				.map-country { fill: var(--neutral-background-strong); transition: fill var(--transition-micro-medium); }
				.route-map:hover .map-country { fill: var(--accent-background-medium); }
				.map-pin { cursor: pointer; transition: transform var(--transition-micro-medium); }
				.map-pin:hover { transform: scale(1.15); }
				.map-pin:focus-visible { outline: 2px solid var(--accent-solid-strong); outline-offset: 2px; }

				/* Capa de ondas (agua) por debajo del mapa */
				.wave-layer { pointer-events: none; }
				.wave {
					fill: var(--accent-background-medium);
					opacity: 0.35;
					filter: blur(2px);
					animation: ripple 0.7s ease-out forwards;
					transform-origin: center center;
				}
				@keyframes ripple {
					0% { r: 0; opacity: 0.45; transform: scale(1); }
					100% { r: 420; opacity: 0; transform: scale(1); }
				}
				@media (prefers-reduced-motion: reduce) {
					.wave { animation: none; display: none; }
				}
			`}
		</style>

		<!-- Capa de ondas (agua) por debajo de todo -->
		<g class="wave-layer" id="wave-layer"></g>

		<!-- Países de fondo -->
		{map.countries.map((c) => (
			<path
				class="map-country"
				d={c.d}
				stroke="var(--neutral-alpha-strong)"
				stroke-width="1"
				vector-effect="non-scaling-stroke"
			/>
		))}

		<!-- Rutas -->
		{map.trips.map((trip) => (
			<g class="map-route">
				<path
					d={trip.d}
					fill="none"
					stroke-linejoin="round"
					stroke-linecap="round"
					stroke="var(--neutral-background-medium)"
					stroke-width="6"
					opacity="0.9"
				/>
				<path
					d={trip.d}
					fill="none"
					stroke-linejoin="round"
					stroke-linecap="round"
					stroke={`var(--${trip.colorToken})`}
					stroke-width="3"
				/>
			</g>
		))}

		<!-- Pins -->
		{map.points.map((p) => (
			<a
				href={p.href}
				class="map-pin"
				aria-label={esc(p.name + ' — leer artículo')}
			>
				<title>{esc(p.name + ' — ' + p.description)}</title>
				<circle
					class="map-pin-base"
					cx={p.x}
					cy={p.y}
					r="10"
					fill="var(--accent-solid-strong)"
					stroke="var(--page-background)"
					stroke-width="2"
					vector-effect="non-scaling-stroke"
				/>
				<circle
					class="map-pin-dot"
					cx={p.x}
					cy={p.y}
					r="3.5"
					fill="var(--page-background)"
				/>
			</a>
		))}
	</svg>

	<div class="mt-6 text-body-s text-neutral-on-background-weak">
		Países mostrados: {countryNames}. Atribución: datos de límites de OpenStreetMap contributors.
	</div>
</section>

<script>
	(function () {
		var svg = document.querySelector('.route-map');
		var layer = document.getElementById('wave-layer');
		if (!svg || !layer) return;

		function pointerToSvg(evt) {
			var pt = svg.createSVGPoint();
			var rect = svg.getBoundingClientRect();
			var scaleX = svg.viewBox.baseVal.width / rect.width;
			var scaleY = svg.viewBox.baseVal.height / rect.height;
			pt.x = (evt.clientX - rect.left) * scaleX;
			pt.y = (evt.clientY - rect.top) * scaleY;
			return pt;
		}

		function createWave(x, y) {
			var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
			circle.setAttribute('class', 'wave');
			circle.setAttribute('cx', x);
			circle.setAttribute('cy', y);
			circle.setAttribute('r', 0);
			layer.appendChild(circle);
			setTimeout(function () {
				if (circle.parentNode) circle.parentNode.removeChild(circle);
			}, 700);
		}

		svg.addEventListener('click', function (evt) {
			var pt = pointerToSvg(evt);
			createWave(pt.x, pt.y);
		});
	})();
</script>
