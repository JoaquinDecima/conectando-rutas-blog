---
import mapData from '../data/map-data.json';

interface MapPoint {
	id: string;
	name: string;
	description: string;
	country: string;
	href: string;
	trip: string;
	x: number;
	y: number;
}

interface MapTrip {
	id: string;
	name: string;
	colorToken: string;
	d: string;
	points: MapPoint[];
}

interface MapData {
	viewBox: [number, number];
	countries: Array<{ name: string; d: string }>;
	trips: MapTrip[];
	points: MapPoint[];
}

const map = mapData as unknown as MapData;
const [width, height] = map.viewBox;
const countryNames = map.countries.map((c) => c.name).join(' y ');

function esc(s: string): string {
	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-20">
	<div class="text-center mb-8">
		<h2 class="font-heading text-display-m font-light text-neutral-on-background-strong mb-2">El mapa de mis rutas</h2>
		<p class="text-body-m text-neutral-on-background-medium max-w-2xl mx-auto">
			Lugares que he visitado y rutas recorridas. Haz clic en cada pin para leer la historia completa.
		</p>
	</div>

	<div class="relative aspect-[4/3] w-full overflow-hidden bg-page" id="water-container" style="z-index: 0;">
		<!-- jquery.ripples inyecta su canvas de agua dentro de este contenedor, debajo del SVG -->
		<div style="position: relative; z-index: 10;">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox={`0 0 ${width} ${height}`}
				preserveAspectRatio="xMidYMid meet"
				class="route-map w-full h-full block"
				aria-label="Mapa de rutas y destinos visitados"
			>
			<defs>
				<style>
					{`
						.route-map .map-country {
							fill: #ffffffcc;
							transition: fill var(--transition-micro-medium);
						}
						.route-map .map-country:hover {
							fill: var(--accent-background-medium);
						}
					`}
				</style>
			</defs>

			<!-- Países de fondo (semi-transparentes para ver el agua debajo) -->
			{map.countries.map((c) => (
				<path
					class="map-country"
					d={c.d}
					fill="#ffffffcc"
					stroke="var(--neutral-alpha-strong)"
					stroke-width="1"
					vector-effect="non-scaling-stroke"
				/>
			))}

			<!-- Rutas -->
			{map.trips.map((trip) => (
				<g class="map-route">
					<path
						d={trip.d}
						fill="none"
						stroke-linejoin="round"
						stroke-linecap="round"
						stroke="var(--neutral-background-medium)"
						stroke-width="6"
						opacity="0.9"
					/>
					<path
						d={trip.d}
						fill="none"
						stroke-linejoin="round"
						stroke-linecap="round"
						stroke={`var(--${trip.colorToken})`}
						stroke-width="3"
					/>
				</g>
			))}

			<!-- Pins -->
			{map.points.map((p) => (
				<a
					href={p.href}
					class="map-pin"
					aria-label={esc(p.name + ' — leer artículo')}
				>
					<title>{esc(p.name + ' — ' + p.description)}</title>
					<circle
						class="map-pin-base"
						cx={p.x}
						cy={p.y}
						r="10"
						fill="var(--accent-solid-strong)"
						stroke="var(--page-background)"
						stroke-width="2"
						vector-effect="non-scaling-stroke"
					/>
					<circle
						class="map-pin-dot"
						cx={p.x}
						cy={p.y}
						r="3.5"
						fill="var(--page-background)"
					/>
				</a>
			))}
			</svg>
		</div>
	</div>

	<div class="mt-6 text-body-s text-neutral-on-background-weak">
		Países mostrados: {countryNames}. Atribución: datos de límites de OpenStreetMap contributors.
	</div>
</section>

<style>
	:global(#water-container canvas) {
		position: absolute !important;
		inset: 0 !important;
		z-index: 0 !important;
		pointer-events: none !important;
	}
	:global(#water-container .route-map) {
		position: relative !important;
		z-index: 10 !important;
	}
</style>

<script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
<script>
	(function () {
		// Cargar jquery.ripples solo después de que jQuery esté disponible
		function waitForJQuery() {
			if (window.jQuery) {
				loadRipples();
			} else {
				setTimeout(waitForJQuery, 50);
			}
		}

		function loadRipples() {
			var script = document.createElement('script');
			script.src = 'https://cdn.jsdelivr.net/npm/jquery.ripples@0.6.3/dist/jquery.ripples.min.js';
			script.onload = initRipples;
			document.head.appendChild(script);
		}

		function initRipples() {
			var $container = $('#water-container');
			if (!$container.length) return;

			// Efecto de agua idéntico al del ejemplo: jquery.ripples sobre el contenedor.
			// El canvas de agua se inyecta debajo del SVG; el SVG (mapa + pins) queda encima y no se distorsiona.
			$container.ripples({
				resolution: 512,
				dropRadius: 20,
				perturbance: 0.04,
			});

			// Gotas automáticas para que el agua se vea viva sin que el usuario interactúe
			setInterval(function () {
				var x = Math.random() * $container.width();
				var y = Math.random() * $container.height();
				$container.ripples('drop', x, y, 20, 0.04);
			}, 900);
		}

		waitForJQuery();
	})();
</script>
