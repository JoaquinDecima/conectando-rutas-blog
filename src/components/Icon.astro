const filled = new Set(['tiktok', 'instagram', 'youtube']);

const { name, size = 16, class: className, strokeWidth = 2 } = Astro.props;
const isFilled = filled.has(name);
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	class={className}
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width={isFilled ? undefined : strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={icons[name]}
/>
