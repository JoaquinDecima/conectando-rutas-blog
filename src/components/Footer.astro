---
import Icon from './Icon.astro';
import { NAV_LINKS, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const today = new Date();
const year = today.getFullYear();
---

<footer class="border-t border-neutral-alpha-weak bg-neutral-background-weak">
		<div class="mx-auto max-w-7xl px-4 py-12 sm:px-8">
		<div class="flex flex-col justify-between gap-10 md:flex-row">
			<div class="max-w-sm">
				<a
					href=""
					class="flex items-center gap-2 font-heading text-heading-s text-neutral-on-background-strong"
				>
					<Icon name="compass" size={20} class="text-accent-on-background-weak" strokeWidth={1.75} />
					<span>{SITE_TITLE}</span>
				</a>
				<p class="mt-3 text-body-s text-neutral-on-background-weak">{SITE_DESCRIPTION}</p>
			</div>

			<nav class="flex flex-col gap-2" aria-label="Navegación del pie de página">
				<p class="text-label-s font-semibold text-neutral-on-background-strong">Explorar</p>
				{
					NAV_LINKS.map((link) => (
						<a
							href={link.href}
							class="text-label-s text-neutral-on-background-weak transition-colors duration-100 hover:text-accent-on-background-weak"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex flex-col gap-2">
				<p class="text-label-s font-semibold text-neutral-on-background-strong">Síguenos</p>
				<div class="flex items-center gap-3">
					{
						SOCIAL_LINKS.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener"
								class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-alpha-weak text-neutral-on-background-medium transition-colors duration-100 hover:border-accent-border-medium hover:text-accent-on-background-weak"
								aria-label={social.label}
							>
								<Icon name={social.icon} size={16} />
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-2 border-t border-neutral-alpha-weak pt-6 text-label-xs text-neutral-on-background-weak sm:flex-row"
		>
			<p>&copy; {year} {SITE_TITLE}. Todos los derechos reservados.</p>
			<p>
				Creado por{' '}
				<a
					href="https://vasak.net.ar"
					target="_blank"
					rel="noopener"
					class="transition-colors duration-100 hover:text-accent-on-background-weak"
				>
					<strong>Vasak Group</strong>
				</a>
			</p>
		</div>
	</div>
</footer>
